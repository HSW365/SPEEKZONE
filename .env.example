# ── SpeekZone web build ──────────────────────────────────────────────
# Copy to `.env` for local dev, or set these in Render → speekzone-web → Environment.

# Live backend the web app talks to (auth, rooms, gifts, socket).
VITE_API_URL=https://speekzone-api.onrender.com

# Web billing (Stripe). These are PUBLIC URLs — safe to ship in the bundle.
# Create a Payment Link for the $9.99/mo "Verified" plan at
# https://dashboard.stripe.com/payment-links and paste it here.
VITE_STRIPE_VERIFIED_LINK=
# Optional: Stripe billing-portal link so web users can manage/cancel.
VITE_STRIPE_PORTAL_LINK=
